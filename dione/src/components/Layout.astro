---
import ManagedAppLayout from "@ai-outfitter/ui/astro/ManagedAppLayout.astro";
import AgentSidebarToggle from "@ai-outfitter/ui/astro/AgentSidebarToggle.astro";
import AppAgentSidebar from "@ai-outfitter/ui/react/AppAgentSidebar";
import "@ai-outfitter/ui/chat.css";
import "../dione.css";
const {title,page="today"}=Astro.props;
const operational = import.meta.env.OUTFITTER_APP_MODE === "operational";
const panel = "dione-agent";
---
<ManagedAppLayout name="Dione" {title} description="A daily briefing from your media library and download services." active={page==="settings"?"settings":"home"} settingsHref="./settings" sidebarLinks={[{label:"Today",href:"./",active:page==="today"},{label:"History",href:"./history",active:page==="history"},{label:"Recommendations",href:"./recommendations",active:page==="recommendations"}]}>
<AgentSidebarToggle slot="header-actions" controls={panel} label="Ask Dione" />
<slot />
<AppAgentSidebar slot="overlays" client:idle id={panel} pageId="dione" endpoint="/api/apps/dione/agent" agentName="Dione" demo={!operational} intro="Ask about your library, upcoming releases, and downloads." emptyIntro="What would you like to know about your media?" limits="Reads approved media connections. Downloads and changes require a separate owner review." demoReply="This is a scripted example. Synthetic Moonrise appears in the demo briefing. The Transmission queue shown here is synthetic; a real installation reads your approved connections." />
</ManagedAppLayout>
<script>
import { agentPage } from "@ai-outfitter/app-sdk/agent-context";
agentPage("dione").set({ focus: { kind: "dione", id: "d1000000-0000-4000-8000-000000000001", label: "Dione" } });
</script>
