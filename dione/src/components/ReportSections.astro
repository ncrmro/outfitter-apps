<section id="briefing" aria-live="polite"></section>

<section class="report-section" aria-labelledby="upcoming-title">
  <h2 id="upcoming-title">Upcoming releases <span id="upcoming-count" class="section-count" aria-hidden="true"></span></h2>
  <p class="section-description">Releases from your monitored movies, shows, and music, in date order.</p>
  <p id="upcoming-empty" class="muted">No report loaded yet.</p>
  <ul id="upcoming-items" class="cards"></ul>
</section>

<section class="report-section" aria-labelledby="library-title">
  <h2 id="library-title">Recent library additions <span id="library-count" class="section-count" aria-hidden="true"></span></h2>
  <p class="section-description">Recently added to your library, newest first.</p>
  <p id="library-empty" class="muted">No report loaded yet.</p>
  <ul id="library-items" class="cards"></ul>
</section>

<section class="report-section" aria-labelledby="attention-title">
  <h2 id="attention-title">Needs attention <span id="attention-count" class="section-count" aria-hidden="true"></span></h2>
  <p class="section-description">Missing media, active downloads, and sources that need a check.</p>
  <ul id="source-attention" class="source-alerts" aria-label="Sources needing attention"></ul>
  <p id="attention-empty" class="muted">No report loaded yet.</p>
  <ul id="attention-items" class="cards"></ul>
</section>

<details id="source-freshness" class="source-freshness">
  <summary>Source freshness <span id="source-summary"></span></summary>
  <p id="source-empty" class="muted">No source checks recorded yet.</p>
  <ul id="sources"></ul>
</details>
