{
  "name": "@ai-outfitter/app-autodidact",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./manifest": "./app.json"
  },
  "scripts": {
    "build": "outfitter-app-build",
    "check": "astro check",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --import tsx --test tests/*.unit.test.ts",
    "pretest:integration": "node --import tsx scripts/prepare-tests.ts",
    "test:integration": "node --import tsx --test tests/*.integration.test.ts",
    "preview:build": "outfitter-app-build --mode demo --output dist/preview.json"
  },
  "dependencies": {
    "@ai-outfitter/app-sdk": "0.1.1",
    "@ai-outfitter/server": "0.1.1",
    "@ai-outfitter/ui": "0.1.1",
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^7.0.0",
    "astro": "^7.3.5",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-outfitter/app-build": "0.1.1",
    "@ai-outfitter/app-test": "0.1.1",
    "@astrojs/check": "^0.9.10",
    "@libsql/client": "^0.18.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ai": "^7.0.122",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "outfitter": {
    "kind": "app"
  }
}
