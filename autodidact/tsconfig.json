{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "fixtures/**/*.json",
    "../.outfitter-sdk/packages/ui/src/astro/**/*.astro",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
