---
import ManagedAppLayout from "@ai-outfitter/ui/astro/ManagedAppLayout.astro";
import AgentSidebarToggle from "@ai-outfitter/ui/astro/AgentSidebarToggle.astro";
import DioneSidebar from "./DioneSidebar";
import "@ai-outfitter/ui/chat.css";
import "../dione.css";
const {title,page="today"}=Astro.props;
const operational = import.meta.env.OUTFITTER_APP_MODE === "operational";
const panel = "dione-agent";
---
<ManagedAppLayout name="Dione" {title} description="Upcoming releases, recent library additions, and things needing attention." active={page==="settings"?"settings":"home"} settingsHref="./settings" sidebarLinks={[{label:"Today",href:"./",active:page==="today"},{label:"History",href:"./history",active:page==="history"},{label:"Recommendations",href:"./recommendations",active:page==="recommendations"}]}>
<AgentSidebarToggle slot="header-actions" controls={panel} label="Ask Dione" />
<slot />
<DioneSidebar slot="overlays" client:idle id={panel} pageId="dione" agentName="Dione" demo={!operational} intro="Ask about your library, upcoming releases, and downloads." emptyIntro="What would you like to know about your media?" limits="Reads approved media connections. Movie requests prepare a private review. Only your Approve changes click can add, monitor or search." demoReply="This is a scripted example. Transmission has Synthetic Moonrise at 62% (8.4 MB/s, about 4 minutes left) and Ocean Atlas at 18%. SABnzbd has the new Signal Coast episode at 74%, with Paper Satellites queued behind it. For something ready now, The Long Way Home and Ocean Atlas Season 1 were recently added to Jellyfin. These are fictional demo observations; a real installation reads your approved connections." />
</ManagedAppLayout>
<script>
import { agentPage } from "@ai-outfitter/app-sdk/agent-context";
agentPage("dione").set({ focus: { kind: "dione", id: "d1000000-0000-4000-8000-000000000001", label: "Dione" } });
</script>
