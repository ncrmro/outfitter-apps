{
  "name": "@ai-outfitter/app-yoga-practice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./manifest": "./app.json"
  },
  "scripts": {
    "build": "cd ../../.. && node --import tsx scripts/build-apps.mjs yoga-practice --mode demo && node --import tsx scripts/build-apps.mjs yoga-practice --mode operational",
    "check": "astro check",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --import tsx --test tests/*.unit.test.ts",
    "pretest:integration": "node --import tsx scripts/prepare-tests.ts",
    "test:integration": "node --import tsx --test tests/*.integration.test.ts",
    "pretest:e2e": "node --import tsx scripts/prepare-tests.ts",
    "test:e2e": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@ai-outfitter/app-sdk": "0.1.0",
    "@ai-outfitter/server": "0.1.0",
    "@ai-outfitter/ui": "0.1.0",
    "@ai-outfitter/workflow-yoga-health-sync": "0.1.0",
    "@astrojs/cloudflare": "^14.3.3",
    "astro": "^7.3.5",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-outfitter/app-test": "0.1.0",
    "@astrojs/check": "^0.9.10",
    "@libsql/client": "^0.18.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "outfitter": {
    "kind": "app",
    "inputs": [
      "catalog/outfitter-apps/apple-health.ts",
      "catalog/outfitter-apps/apple-health-test-host.ts"
    ]
  }
}
