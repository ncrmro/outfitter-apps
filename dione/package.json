{
  "name": "@ncrmro/app-dione",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./manifest": "./app.json"
  },
  "scripts": {
    "build": "outfitter-app-build",
    "check": "astro check && node --import tsx scripts/graph-schema.ts --check",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --import tsx --test tests/*.unit.test.ts tests/movie-download.test.mjs",
    "pretest:integration": "node --import tsx scripts/prepare-tests.ts",
    "test:integration": "node --import tsx --test tests/*.integration.test.ts",
    "pretest:e2e": "node --import tsx scripts/prepare-tests.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "preview:build": "outfitter-app-build --mode demo --output dist/preview.json",
    "demo:seed": "node --import tsx scripts/demo-fixtures.ts",
    "baseline:prod": "node --import tsx scripts/production-baseline.ts"
  },
  "dependencies": {
    "@ai-outfitter/app-sdk": "0.1.1",
    "@ai-outfitter/server": "0.1.1",
    "@ai-outfitter/ui": "0.1.1",
    "@astrojs/cloudflare": "^14.3.3",
    "astro": "^7.3.5",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "zod": "^4.6.5",
    "@ncrmro/workflow-dione-briefing": "0.1.0",
    "graphql": "^16.11.0",
    "@astrojs/react": "^7.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@ai-outfitter/app-test": "0.1.1",
    "@astrojs/check": "^0.9.10",
    "@libsql/client": "^0.18.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "@ai-outfitter/app-build": "0.1.1",
    "@ncrmro/connector-radarr": "0.1.0",
    "@ncrmro/connector-sonarr": "0.1.0",
    "@ncrmro/connector-lidarr": "0.1.0",
    "@ncrmro/connector-jellyfin": "0.1.0",
    "@ncrmro/connector-transmission": "0.1.0",
    "@ncrmro/connector-sabnzbd": "0.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "outfitter": {
    "kind": "app",
    "inputs": []
  }
}
